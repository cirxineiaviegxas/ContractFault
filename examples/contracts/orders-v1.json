{
  "service": "orders-api",
  "version": "1.4.0",
  "types": {
    "Money": {
      "kind": "object",
      "fields": {
        "amount": { "type": "integer", "required": true, "doc": "minor units" },
        "currency": { "type": "string", "required": true }
      }
    },
    "OrderStatus": {
      "kind": "string",
      "enum": ["pending", "paid", "shipped", "cancelled", "refunded"]
    },
    "LineItem": {
      "kind": "object",
      "fields": {
        "sku": { "type": "string", "required": true },
        "qty": { "type": "integer", "required": true },
        "price": { "type": "Money", "required": true }
      }
    },
    "Order": {
      "kind": "object",
      "fields": {
        "id": { "type": "string", "required": true },
        "status": { "type": "OrderStatus", "required": true },
        "items": { "type": "LineItem", "required": true, "array": true },
        "total": { "type": "Money", "required": true },
        "note": { "type": "string", "nullable": true, "doc": "free-form customer note" },
