{
  "service": "orders-api",
  "version": "2.0.0",
  "types": {
    "Money": {
      "kind": "object",
      "fields": {
        "amount": { "type": "integer", "required": true, "doc": "minor units" },
        "currency": { "type": "string", "required": true },
        "display": { "type": "string", "doc": "preformatted display string" }
      }
    },
    "OrderStatus": {
      "kind": "string",
      "enum": ["pending", "authorized", "paid", "shipped", "delivered", "cancelled"]
    },
    "LineItem": {
      "kind": "object",
      "fields": {
        "sku": { "type": "string", "required": true },
        "qty": { "type": "integer", "required": true },
        "price": { "type": "Money", "required": true },
        "giftWrapped": { "type": "boolean" }
      }
    },
    "Order": {
      "kind": "object",
      "fields": {
        "id": { "type": "string", "required": true },
        "status": { "type": "OrderStatus", "required": true },
        "items": { "type": "LineItem", "required": true, "array": true },
        "total": { "type": "Money", "required": true },
        "note": { "type": "string", "nullable": true, "doc": "free-form customer note" },
        "customerId": { "type": "string", "required": true, "doc": "owning customer" }
      }
    },
    "CreateOrderRequest": {
      "kind": "object",
      "fields": {
        "items": { "type": "LineItem", "required": true, "array": true },
        "couponCode": { "type": "string" },
        "customerId": { "type": "string", "required": true }
      }
    },
    "Error": {
      "kind": "object",
      "fields": {
        "code": { "type": "string", "required": true },
        "message": { "type": "string", "required": true },
        "traceId": { "type": "string" }
      }
    }
  },
  "endpoints": [
    {
      "id": "listOrders",
      "method": "GET",
      "path": "/orders",
      "idempotent": true,
      "params": [
        { "name": "status", "in": "query", "type": "OrderStatus" },
        { "name": "limit", "in": "query", "type": "integer", "required": true },
        { "name": "cursor", "in": "query", "type": "string" }
      ],
      "responses": { "200": "Order", "400": "Error" }
    },
    {
      "id": "getOrder",
      "method": "GET",
      "path": "/orders/{id}",
      "idempotent": true,
      "params": [
        { "name": "id", "in": "path", "type": "string", "required": true }
      ],
      "responses": { "200": "Order", "404": "Error" }
    },
    {
      "id": "createOrder",
      "method": "POST",
      "path": "/orders",
      "idempotent": false,
      "requestType": "CreateOrderRequest",
      "responses": { "201": "Order", "400": "Error", "422": "Error" }
    },
    {
      "id": "cancelOrder",
      "method": "DELETE",
      "path": "/orders/{id}",
      "idempotent": false,
      "params": [
        { "name": "id", "in": "path", "type": "string", "required": true }
      ],
      "responses": { "200": "Order", "404": "Error", "409": "Error" }
    }
  ]
}
