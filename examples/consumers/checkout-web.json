{
  "name": "checkout-web",
  "team": "storefront",
  "criticality": "high",
  "uses": [
    {
      "endpoint": "createOrder",
      "writesFields": ["CreateOrderRequest.items", "CreateOrderRequest.couponCode"],
      "readsFields": ["Order.id", "Order.status", "Order.total"]
    },
    {
      "endpoint": "getOrder",
      "readsFields": ["Order.id", "Order.status", "Order.items", "Order.total", "Order.couponCode"]
    },
    {
      "endpoint": "cancelOrder"
    }
  ]
}
